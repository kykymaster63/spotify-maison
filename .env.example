# Backend
JWT_SECRET=change_me_in_production
DATABASE_URL=postgres://spotify:spotify123@localhost:5432/spotify_maison
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=spotify-maison

# Import de playlists Spotify (optionnel) — créer une appli gratuite sur
# https://developer.spotify.com/dashboard pour obtenir ces identifiants.
# Sans eux, tout le reste de l'app fonctionne normalement, seul l'import
# depuis un lien de playlist Spotify sera indisponible.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Frontend
VITE_API_URL=http://localhost:3000
